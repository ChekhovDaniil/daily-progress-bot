    "search.exclude": {
        "**/__pycache__": true,
        "**/*.py[cod]": true,
        "**/.coverage": true,
        "**/.env": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.venv": true,
        "**/build": true,
        "**/dist": true,
        "**/*.egg-info": true,
        "**/htmlcov": true,
        "**/info.txt": true,
        "**/tempCodeRunnerFile.py": true,
